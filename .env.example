# Copy this file to .env and replace placeholders.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_GOOGLE_CLIENT_ID=599140815070-9h16gad0fdtvkjif7bkvfk3ppakgl01m.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=599140815070-9h16gad0fdtvkjif7bkvfk3ppakgl01m.apps.googleusercontent.com
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Prisma-only Supabase Postgres connection.
# Use the pooled transaction URL for runtime and the session/direct URL for Prisma schema changes.
DATABASE_URL="postgres://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres"
REDIS_URL=redis://localhost:6379

AUTH_ISSUER=travox
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_COOKIE_NAME=travox-at
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_TOKEN_SECRET=replace-with-random-refresh-secret
AUTH_ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace-with-rs256-private-key
-----END PRIVATE KEY-----"
AUTH_ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
replace-with-rs256-public-key
-----END PUBLIC KEY-----"

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ALLOW_LOCAL_FALLBACK=true
LOCAL_FILE_STORAGE_PATH=tmp/file-storage
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SHARED_FOLDER_ID=

GEMINI_API_KEY=
LOG_LEVEL=info
NEXT_PUBLIC_MAINTENANCE_ENABLED=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=
NEXT_PUBLIC_MAINTENANCE_DETAILS=
